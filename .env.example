# PostgreSQL connection string (leave empty in development to use embedded in-memory PostgreSQL with seeded state)
DATABASE_URL=

# Base64-encoded 32-byte Key Encryption Key for AES-256-GCM secret envelope encryption
OMNI_KEK=

# Public base URL for generated subscription links
OMNI_PUBLIC_URL=http://localhost:3000

# Optional one-time token required during /setup owner bootstrap
OMNI_SETUP_TOKEN=

# Set to 1 in local HTTP development to allow session cookies over non-TLS localhost
OMNI_INSECURE_COOKIES=1
