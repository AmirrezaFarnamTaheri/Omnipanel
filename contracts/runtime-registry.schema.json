{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.omnipanel.invalid/v2/runtime-registry.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runtimes"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0"
    },
    "runtimes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "runtime",
          "protocol",
          "version",
          "artifactDigest",
          "platform",
          "status",
          "requiredClaims"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "runtime": {
            "enum": [
              "singbox",
              "hysteria2",
              "xray"
            ]
          },
          "protocol": {
            "enum": [
              "vless-reality-vision",
              "hysteria2"
            ]
          },
          "version": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"
              },
              {
                "type": "null"
              }
            ]
          },
          "artifactDigest": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "platform": {
            "enum": [
              "linux/amd64",
              "linux/arm64"
            ]
          },
          "status": {
            "enum": [
              "candidate",
              "lab_verified"
            ]
          },
          "requiredClaims": {
            "type": "array",
            "items": {
              "enum": [
                "client_import",
                "connectivity_l3",
                "credential_revocation",
                "accounting",
                "outbound_reconciliation",
                "last_good_recovery",
                "version_rejection",
                "impairment_diagnosis"
              ]
            },
            "minItems": 8,
            "uniqueItems": true
          }
        }
      }
    }
  }
}
